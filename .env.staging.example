# ==================================
# STAGING ENVIRONMENT VARIABLES
# ==================================
# Copiar este archivo a:
# - Backend: apps/backend/.env.staging
# - Frontend: apps/frontend/.env.staging

# ==================================
# BACKEND (.env.staging)
# ==================================

NODE_ENV=staging
PORT=3000

# Database (Usar Neon/Supabase free tier)
DATABASE_URL=postgresql://user:password@staging-db.neon.tech:5432/ovp_staging

# OpenAI
OPENAI_API_KEY=sk-proj-YOUR_STAGING_KEY_HERE
OPENAI_ASSISTANT_ID=asst_YOUR_STAGING_ASSISTANT_ID

# Anthropic (si se migra)
ANTHROPIC_API_KEY=sk-ant-YOUR_STAGING_KEY_HERE

# CORS
CORS_ORIGIN=https://staging-objetivovientreplano.vercel.app

# Session
SESSION_SECRET=staging-secret-key-min-32-characters-here-change-this

# Redis (opcional)
REDIS_URL=redis://localhost:6379

# WordPress (staging)
WORDPRESS_API_URL=https://staging.objetivovientreplano.com/wp-json
WORDPRESS_API_USERNAME=staging_api_user
WORDPRESS_API_PASSWORD=staging_api_password

# ==================================
# FRONTEND (.env.staging)
# ==================================

VITE_API_URL=https://staging-api-objetivovientreplano.railway.app
VITE_DEFAULT_LANGUAGE=es
VITE_ENVIRONMENT=staging

# Feature Flags (para testing)
VITE_ENABLE_PRO_FEATURES=true
VITE_ENABLE_AUTH=true
VITE_ENABLE_MEMORY=true
