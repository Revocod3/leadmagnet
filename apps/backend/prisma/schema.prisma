generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String?  // Null for OAuth users

  // OAuth fields
  googleId      String?  @unique
  facebookId    String?  @unique
  provider      String   @default("email") // "email" | "google" | "facebook"
  emailVerified Boolean  @default(false)

  // Role and subscription
  role                String   @default("FREE") // "FREE" | "PRO"
  stripeCustomerId    String?  @unique

  // Password reset
  passwordResetToken  String?  @unique
  passwordResetExpiry DateTime?

  // Onboarding
  birthDate           DateTime?
  onboardingCompleted Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions           Session[]
  diagnoses          Diagnosis[]
  subscriptions      Subscription[]
  conversations      ProConversation[]  // PRO user conversations
  
  // Clara Premium models
  globalContext      UserGlobalContext?
  diaryEntries       DiaryEntry[]
  dailyCheckIns      DailyCheckIn[]
  userChallenges     UserChallenge[]
  pushSubscriptions  PushSubscription[]
  reminders          Reminder[]

  @@map("users")
}

// ═══════════════════════════════════════════════════════════════
// PRO FLOW MODELS - Separate from FREE diagnostic flow
// ═══════════════════════════════════════════════════════════════

model ProConversation {
  id                   String   @id @default(cuid())
  userId               String
  title                String?  // Auto-generated from first messages
  summary              String?  @db.Text // Compact summary for context in future conversations
  openaiConversationId String?  // OpenAI conversation/thread ID
  
  // Metadata
  messageCount         Int      @default(0)
  lastMessageAt        DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages             ProMessage[]

  @@index([userId])
  @@index([lastMessageAt])
  @@map("pro_conversations")
}

model ProMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // "user" | "assistant"
  content        String   @db.Text
  metadata       Json?    // For storing additional info like image URLs, etc.
  createdAt      DateTime @default(now())

  conversation   ProConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@map("pro_messages")
}

model Session {
  id                   String    @id @default(cuid())
  userId               String?
  userName             String?
  userEmail            String?
  language             String    @default("es")
  diagnosticType       String?   // "chat" | "quiz"
  step                 String    @default("initial")
  currentQuestionIndex Int       @default(0)
  imageAnalysisText    String?
  assistantId          String?
  threadId             String?
  flowState            Json?     // Store diagnostic flow state as JSON
  startTime            DateTime  @default(now())
  completionTime       DateTime?
  expiresAt            DateTime

  // Engagement tracking fields
  diagnosticMode       String?   // "express" | "standard" | "deep"
  engagementScore      Float?    // 0-100
  questionsAsked       Int       @default(0)
  avgResponseLength    Float?    // Average words per response
  timeSpent            Int?      // Total time in milliseconds
  completedDiagnosis   Boolean   @default(false)
  convertedToChat      Boolean   @default(false)
  engagementSignals    Json?     // EngagementSignals object
  wordpressLeadId      String?   // WordPress lead ID
  
  // Interaction limits tracking
  hasSharedImage       Boolean   @default(false)  // Track if user shared a photo
  messageCount         Int       @default(0)      // Total user messages sent
  postDiagnosisMessageCount Int  @default(0)      // Messages after diagnosis delivered

  user                  User?                   @relation(fields: [userId], references: [id])
  messages              Message[]
  quizAnswers           QuizAnswer[]
  diagnosis             Diagnosis?
  discountCodes         DiscountCode[]
  conversationalMemory  ConversationalMemory?
  chatRatings           ChatRating[]

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Message {
  id        String   @id @default(cuid())
  sessionId String
  role      String   // "user" | "assistant"
  content   String   @db.Text
  metadata  Json?
  createdAt DateTime @default(now())

  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("messages")
}

model QuizAnswer {
  id         String   @id @default(cuid())
  sessionId  String
  questionId Int
  answer     String
  points     Int
  createdAt  DateTime @default(now())

  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("quiz_answers")
}

model Diagnosis {
  id               String   @id @default(cuid())
  sessionId        String   @unique
  userId           String?
  content          String   @db.Text
  totalScore       Int?
  scorePercentage  Float?
  pdfGenerated     Boolean  @default(false)
  createdAt        DateTime @default(now())

  // Engagement tracking
  diagnosticMode   String?  // Mode used for diagnosis
  questionsAsked   Int?     // Number of questions asked
  engagementScore  Float?   // Final engagement score

  session          Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user             User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("diagnoses")
}

model DiscountCode {
  id         String    @id @default(cuid())
  code       String    @unique
  sessionId  String
  percentage Int       // Discount percentage (e.g., 30 for 30%)
  expiresAt  DateTime
  used       Boolean   @default(false)
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([code])
  @@map("discount_codes")
}

model ConversationalMemory {
  id               String   @id @default(cuid())
  sessionId        String   @unique

  // Factual information extracted from conversation
  factualInfo      Json     @default("{}") // { demographics, health, lifestyle, goals }

  // Emotional markers detected during conversation
  emotionalMarkers Json     @default("[]") // Array of { turn, emotion, intensity, trigger }

  // Key moments in conversation
  keyMoments       Json     @default("[]") // Array of { turn, type, content, significance }

  // User communication style
  userStyle        Json     @default("{}") // { formality, verbosity, emotionLevel }

  // Current hypothesis about diagnosis
  currentHypothesis Json    @default("{}") // { primary, confidence, evidence, needsConfirmation }

  // Conversation phase tracking
  conversationPhase String  @default("introduction") // introduction, exploration, deepening, conclusion

  // Topic tracking
  topicsExplored   Json     @default("[]") // Array of explored topics

  // Turn count
  turnCount        Int      @default(0)

  // Timestamps
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  session          Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("conversational_memory")
}

model ChatRating {
  id          String    @id @default(cuid())
  sessionId   String
  rating      Int       // 1-5 stars
  comment     String?   @db.Text
  flowType    String    // "free" | "paid"
  createdAt   DateTime  @default(now())

  session     Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("chat_ratings")
}

model Subscription {
  id                    String    @id @default(cuid())
  userId                String
  stripeSubscriptionId  String    @unique
  stripeCustomerId      String
  stripePriceId         String
  stripeProductId       String?

  // Subscription details
  plan                  String    // "monthly" | "yearly" | "lifetime"
  status                String    // "active" | "canceled" | "past_due" | "incomplete" | "trialing" | "unpaid"

  // Billing period
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  cancelAtPeriodEnd     Boolean   @default(false)
  canceledAt            DateTime?

  // Trial
  trialStart            DateTime?
  trialEnd              DateTime?

  // Metadata
  metadata              Json?     // Additional Stripe metadata

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripeCustomerId])
  @@index([status])
  @@map("subscriptions")
}

// ═══════════════════════════════════════════════════════════════
// CLARA PREMIUM MODELS - Global context, diary, challenges, notifications
// ═══════════════════════════════════════════════════════════════

// Global context that persists across ALL conversations for a user
model UserGlobalContext {
  id                    String   @id @default(cuid())
  userId                String   @unique

  // User profiles extracted from conversations
  digestiveProfile      Json     @default("{}") // { symptoms, patterns, triggers, intolerances }
  emotionalProfile      Json     @default("{}") // { stressLevel, emotionalPatterns, gutBrainConnection }
  culturalProfile       Json     @default("{}") // { country, timezone, foodCulture, mealSchedule, religion }
  habitsProfile         Json     @default("{}") // { eatingSpeed, cookingAbility, hydration, exercise, sleep }
  medicalHistory        Json     @default("{}") // { diagnoses, medications, surgeries, allergies }
  
  // Goals and progress
  goals                 Json     @default("[]") // Array of user goals
  identifiedTriggers    Json     @default("[]") // Foods/situations that cause issues
  strengths             Json     @default("[]") // User's identified strengths
  
  // Program tracking
  currentPhase          String   @default("onboarding") // "onboarding" | "week1" | "week2" | "week3" | "week4" | "maintenance"
  weekNumber            Int      @default(0)
  daysInProgram         Int      @default(0)
  programStartDate      DateTime?
  
  // Premium Onboarding (55 questions flow)
  onboardingTurn        Int      @default(0)  // Current turn in onboarding (0=not started, 1=welcome, 2-56=questions, 57+=completed)
  onboardingCompleted   Boolean  @default(false)
  
  // Radiografía Premium
  radiographyCompleted  Boolean  @default(false)
  radiographyContent    String?  @db.Text  // The generated radiography
  radiographyDate       DateTime?
  
  // User personality/style for adaptation
  personalityType       String?  // "timido" | "extrovertido" | "emocional" | "racional" | "esceptico" | etc.
  communicationStyle    Json     @default("{}") // { formality, verbosity, emotionLevel, preferredTone }
  
  // Last interaction tracking
  lastCheckInDate       DateTime?
  lastDiaryEntryDate    DateTime?
  consecutiveDays       Int      @default(0)  // Days in a row user has interacted
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_global_contexts")
}

// Daily diary entries written by the user
model DiaryEntry {
  id          String   @id @default(cuid())
  userId      String
  
  // Content
  content     String   @db.Text  // User's diary text
  
  // Quick metrics (1-10 scale)
  mood        Int?     // 1-10 emotional state
  bloating    Int?     // 1-10 abdominal bloating
  energy      Int?     // 1-10 energy level
  stress      Int?     // 1-10 stress level
  
  // Detailed tracking
  symptoms    Json     @default("[]") // Array of symptoms experienced
  meals       Json     @default("[]") // What they ate today
  triggers    Json     @default("[]") // Digestive triggers identified
  improvements Json    @default("[]") // Improvements noted
  
  // Clara's response/notes on the entry
  claraNotes  String?  @db.Text
  
  // Date tracking
  date        DateTime @db.Date  // The date this entry is for
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])  // One entry per day per user
  @@index([userId])
  @@index([date])
  @@map("diary_entries")
}

// Daily check-ins for the 4-route system
model DailyCheckIn {
  id                    String   @id @default(cuid())
  userId                String
  date                  DateTime @db.Date
  
  // 4 routes tracking
  digestiveStatus       String?  // How was your belly today?
  emotionalStatus       String?  // How did you feel emotionally?
  microActionCompleted  Boolean  @default(false)  // Did they complete today's action?
  microActionNotes      String?  // Notes about the micro action
  
  // Celebration tracking
  celebrationGiven      Boolean  @default(false)  // Did Clara celebrate their progress?
  
  notes                 String?  @db.Text
  createdAt             DateTime @default(now())

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@map("daily_check_ins")
}

// Catalog of micro-challenges
model MicroChallenge {
  id            String   @id @default(cuid())
  
  // Challenge details
  title         String   @unique  // e.g., "Respiración antes de comer"
  description   String   @db.Text  // Detailed description
  category      String   // "breathing" | "eating" | "hydration" | "mindfulness" | "movement"
  durationDays  Int      @default(1)  // How many days for this challenge
  
  // Difficulty and targeting
  difficulty    String   @default("easy")  // "easy" | "medium" | "hard"
  targetPhase   String?  // Which phase this is good for, null = any
  points        Int      @default(10) // Points earned for completion
  
  // Instructions Clara should give
  instructions  String   @db.Text  // What Clara tells the user
  followUpQuestion String @db.Text // Question Clara asks after
  
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  userChallenges UserChallenge[]

  @@map("micro_challenges")
}

// User's assigned challenges
model UserChallenge {
  id            String    @id @default(cuid())
  userId        String
  challengeId   String
  
  // Status tracking
  status        String    @default("assigned")  // "assigned" | "in_progress" | "completed" | "skipped"
  assignedAt    DateTime  @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  
  // User feedback
  feedback      String?   @db.Text  // How did they feel about it?
  rating        Int?      // 1-5 how helpful was it
  notes         String?   @db.Text  // Notes about completion
  pointsEarned  Int?      // Points earned (may include bonuses)
  
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge     MicroChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([challengeId])
  @@index([status])
  @@map("user_challenges")
}

// Web Push subscriptions for notifications
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  
  // Web Push subscription data
  endpoint  String   @unique
  p256dh    String   // Public key
  auth      String   // Auth secret
  
  // Device info
  userAgent String?
  
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// User reminder preferences
model Reminder {
  id             String   @id @default(cuid())
  userId         String
  
  // Reminder type
  type           String   // "diary" | "checkin" | "challenge" | "motivation"
  
  // Scheduling
  preferredTime  String   // HH:MM format in user's timezone
  timezone       String   @default("Europe/Madrid")
  enabled        Boolean  @default(true)
  
  // Tracking
  lastSentAt     DateTime?
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])  // One reminder per type per user
  @@index([userId])
  @@index([enabled])
  @@map("reminders")
}

// Global statistics and counters
model GlobalCounter {
  id        String   @id @default(cuid())
  key       String   @unique  // "user_count", "page_views", etc.
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("global_counters")
}